rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shopOwner(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUserId == request.auth.uid;
    }

    match /fairs/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    match /shops/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if shopOwner(id);
    }

    match /menuItems/{id} {
      allow read: if true;
      allow create: if shopOwner(request.resource.data.shopId);
      allow update, delete: if shopOwner(resource.data.shopId);
    }

    match /orders/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if shopOwner(resource.data.shopId)
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /tables/{id} {
      allow read: if true;
      allow create: if shopOwner(request.resource.data.shopId);
      allow update, delete: if shopOwner(resource.data.shopId);
    }

    match /staff/{id} {
      allow read: if signedIn();
      allow create: if shopOwner(request.resource.data.shopId);
      allow update, delete: if shopOwner(resource.data.shopId);
    }

    match /shopCosts/{id} {
      allow read, write: if shopOwner(id);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
