rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /stores/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /fairs/{fairId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
